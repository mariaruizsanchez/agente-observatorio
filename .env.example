# -----------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# -----------------------------------------------------------------------------

# --- PROVEEDOR DE IA ---------------------------------------------------------
# Opción A — GitHub Models (gratis para estudiantes, para DESARROLLO):
AI_BASE_URL=https://models.inference.ai.azure.com
AI_API_KEY=tu_token_de_github_aqui
AI_MODEL=gpt-4o-mini

# Opción B — OpenAI directo (de pago, céntimos/mes, para la PRESENTACIÓN):
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=tu_clave_de_openai_aqui
# AI_MODEL=gpt-4o-mini

# Para cambiar de proveedor: comenta el bloque actual y descomenta el otro.
# No hace falta tocar ningún archivo de código.

# --- BASE DE DATOS (Azure SQL) -----------------------------------------------
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:tu-servidor.database.windows.net,1433;Database=tu-bbdd;Uid=tu-usuario;Pwd=tu-contraseña;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
